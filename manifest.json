{
  "manifest_version": 3,
  "name": "GAW: RE-SEARCH",
  "version": "2.4.0",
  "description": "Search 130,000+ greatawakening.win posts and comments instantly — advanced boolean search, filters, and add-a-post. No login, no tracking.",
  "permissions": ["storage"],
  "host_permissions": ["https://gaw-mod-proxy.gaw-mods-a2f2d0e4.workers.dev/*"],
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "GAW: RE-SEARCH"
  },
  "background": {
    "service_worker": "background.js"
  }
}
