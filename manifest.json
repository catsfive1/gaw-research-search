{
  "manifest_version": 3,
  "name": "GAW Research Search",
  "version": "2.0.0",
  "description": "Search the GAW Firehose archive — instant results from 33K+ posts",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "GAW Research Search"
  },
  "background": {
    "service_worker": "background.js"
  }
}
