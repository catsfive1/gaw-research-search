{
  "manifest_version": 3,
  "name": "GAW Research Search",
  "version": "1.0.0",
  "description": "Advanced research search engine for greatawakening.win via the Firehose archive",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "search.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
